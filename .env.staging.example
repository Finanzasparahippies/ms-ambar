# =========================================================================
# MS AMBAR - Staging Environment Configuration (Example template)
# =========================================================================

# Django Core
SECRET_KEY=your_staging_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend-staging,nginx-staging,msambar.com,www.msambar.com
ENVIRONMENT=staging

# Database (Links to db-staging container)
DB_NAME=msambar_staging
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db-staging
DB_PORT=5432

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe (Staging keys - use test credentials)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=your_staging_webhook_secret

# Frontend & API (Access via Nginx Staging Port)
FRONTEND_URL=https://msambar.com
NEXT_PUBLIC_API_URL=https://msambar.com/api

# Staging Auto-Stop configuration (Time to live: e.g. 24h, 86400s, 1d)
AUTO_STOP_INTERVAL=24h
